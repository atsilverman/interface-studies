# Server-only secrets. Copy to `.env` locally. Never prefix those with VITE_.
# VITE_* is baked into the browser bundle and is public.
#
# Create a user API key: https://cursor.com/dashboard/api
# Paste the value only in `.env` (local) or Vercel env (not VITE_).
# /api/study uses this to build + / remix / edit on device and production.

CURSOR_API_KEY=

# Publishable Supabase values (Project Settings → API). Not secrets.
# The anon key is meant for the browser. RLS/RPC in supabase/schema.sql
# only allows load/save by workspace id — it cannot list other libraries.
# Leave blank to keep the left rail on this device only.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Overrides the shared site workspace UUID (desktop and phone
# otherwise use the same built-in id). Must be a UUID.
